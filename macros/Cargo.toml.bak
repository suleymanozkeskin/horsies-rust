[package]
name = "horsies-macros"
version = "0.1.0-alpha.1"
edition = "2021"
description = "Proc macros for the horsies task queue and workflow engine"
license = "MIT"
repository = "https://github.com/suleymanozkeskin/horsies-rust"
readme = "README.md"

[lib]
proc-macro = true

[dependencies]
syn = { version = "2", features = ["full", "extra-traits"] }
quote = "1"
proc-macro2 = "1"

[dev-dependencies]
horsies = { version = "0.1.0-alpha.1", path = "../horsies" }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
trybuild = "1"
